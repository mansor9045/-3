"backend/app/main.py":"""import json, shutil, subprocess
from pathlib import Path
from uuid import uuid4
from fastapi import FastAPI, UploadFile, File, HTTPException
from fastapi.middleware.cors import CORSMiddleware
from fastapi.responses import FileResponse

BASE=Path("/app/storage"); BASE.mkdir(parents=True,exist_ok=True)
app=FastAPI(title="AI Video Dubbing Platform",version="1.0.0")
app.add_middleware(CORSMiddleware,allow_origins=["*"],allow_credentials=True,allow_methods=["*"],allow_headers=["*"])

@app.get("/health")
def health(): return {"status":"ok"}

@app.get("/api")
def api(): return {"name":"AI Video Dubbing Platform","version":"1.0.0"}

@app.post("/api/projects")
def create_project(name:str="مشروع جديد"):
    pid=str(uuid4()); d=BASE/pid; d.mkdir()
    state={"id":pid,"name":name,"status":"created","progress":0}
    (d/"state.json").write_text(json.dumps(state,ensure_ascii=False))
    return state

@app.post("/api/projects/{pid}/upload")
async def upload(pid:str,file:UploadFile=File(...)):
    d=BASE/pid
    if not d.exists(): raise HTTPException(404,"المشروع غير موجود")
    if not file.filename: raise HTTPException(400,"ملف غير صالح")
    if not (file.content_type or "").startswith("video/"):
        raise HTTPException(400,"يسمح برفع ملفات الفيديو فقط")
    target=d/"source.mp4"
    with target.open("wb") as out: shutil.copyfileobj(file.file,out)
    state=json.loads((d/"state.json").read_text()); state.update(status="uploaded",progress=10)
    (d/"state.json").write_text(json.dumps(state,ensure_ascii=False))
    return {"status":"uploaded","project_id":pid}

@app.post("/api/projects/{pid}/extract-audio")
def extract_audio(pid:str):
    d=BASE/pid; src=d/"source.mp4"; out=d/"audio.wav"
    if not src.exists(): raise HTTPException(404,"ارفع الفيديو أولاً")
    p=subprocess.run(["ffmpeg","-y","-i",str(src),"-vn","-ac","1","-ar","16000","-c:a","pcm_s16le",str(out)],capture_output=True,text=True)
    if p.returncode: raise HTTPException(500,p.stderr[-1000:])
    state=json.loads((d/"state.json").read_text()); state.update(status="audio_ready",progress=20)
    (d/"state.json").write_text(json.dumps(state,ensure_ascii=False))
    return {"status":"audio_ready"}

@app.post("/api/projects/{pid}/process")
def process(pid:str,source_language:str="auto",target_language:str="ar"):
    d=BASE/pid
    if not (d/"source.mp4").exists(): raise HTTPException(404,"ارفع الفيديو أولاً")
    state=json.loads((d/"state.json").read_text())
    state.update(status="queued",progress=25,source_language=source_language,target_language=target_language,
                 pipeline=["extract_audio","speech_to_text","speaker_timestamps","translate","srt","tts","sync","mix","render"])
    (d/"state.json").write_text(json.dumps(state,ensure_ascii=False))
    return state

@app.get("/api/projects/{pid}/status")
def status(pid:str):
    f=BASE/pid/"state.json"
    if not f.exists(): raise HTTPException(404,"المشروع غير موجود")
    return json.loads(f.read_text())

@app.get("/api/projects/{pid}/source")
def source(pid:str):
    f=BASE/pid/"source.mp4"
    if not f.exists(): raise HTTPException(404,"الفيديو غير موجود")
    return FileResponse(f,media_type="video/mp4")
""",
